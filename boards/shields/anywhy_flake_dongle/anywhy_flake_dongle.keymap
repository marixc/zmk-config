/*
 * Anywhy Flake L — Colemak-DH keymap
 *
 * Hardware: Flake L (58-key), XIAO BLE, split wireless
 * Layout: Standard Colemak-DH, single layer, no home-row mods, no combos
 *
 * Large layout matrix (large_transform):
 *   Row 0: cols 0-11  (12 keys — number row with outer modifier keys)
 *   Row 1: cols 0-11  (12 keys — top alpha row)
 *   Row 2: cols 0-11  (12 keys — home alpha row)
 *   Row 3: cols 0-11  (12 keys — bottom alpha row)
 *   Row 4: cols 1-10  (10 keys — thumb cluster)
 *
 * Colemak-DH alpha block (cols 1-10 of rows 1-3):
 *   Q W F P B   J L U Y ;
 *   A R S T G   M N E I O
 *   Z X C D V   K H , . /
 *
 * Outer columns (col 0 and col 11) carry modifier/utility keys.
 * Thumbs carry Cmd/Alt/Ctrl/Space on left, Shift/Cmd/Alt/Ctrl on right.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define FN   1

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Colemak-DH";
            /*
             * 58 bindings in large_transform order:
             *
             * Row 0 (12):  ESC  1  2  3  4  5   |   6  7  8  9  0  MINUS
             * Row 1 (12):  ENTER Q  W  F  P  B   |   J  L  U  Y  ;  BSPC
             * Row 2 (12):  TAB  A  R  S  T  G   |   M  N  E  I  O  APOS
             * Row 3 (12):  LBKT Z  X  C  D  V   |   K  H  ,  .  /  RBKT
             * Thumb (10):     LGUI LALT LCTRL SPACE BSPC   DEL RSHFT RALT RCTRL RGUI
             */
            bindings = <
&lt FN TILDE    &kp N1    &kp N2    &kp N3     &kp N4    &kp N5        &kp N6    &kp N7    &kp N8     &kp N9    &kp N0    &kp MINUS
&kp TAB  &kp Q     &kp W     &kp F      &kp P     &kp B         &kp J     &kp L     &kp U      &kp Y     &kp Z  &kp BSPC
&kp CAPSLOCK    &kp A     &kp R     &kp S      &kp T     &kp G         &kp M     &kp N     &kp E      &kp I     &kp O     &kp ENTER
&kp EQUAL   &mt LGUI COMMA   &mt LALT V     &mt LCTRL C     &mt LSHIFT D     &kp X         &kp K     &mt LSHIFT H     &mt LCTRL SEMI  &mt LALT DOT   &mt LGUI FSLH  &kp APOS
           &mt LGUI LBKT  &kp LEFT  &kp RIGHT  &kp SPACE &kp CAPSLOCK      &kp LC(BSPC)   &kp ENTER &kp DOWN   &kp UP &mt LGUI RBKT
            >;
        };
                fn {
            display-name = "FN";

            bindings = <
&trans &trans &trans &trans &trans &bootloader          &trans &trans &trans &trans &trans &trans
&trans       &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans
&trans       &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans
&trans       &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans &trans
             &trans &trans &trans &trans &trans        &trans &trans &trans &trans &trans
            >;
        };
    };
};
