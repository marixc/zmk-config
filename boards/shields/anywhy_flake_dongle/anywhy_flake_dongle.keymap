/*
 * Anywhy Flake L — Colemak-DH keymap
 *
 * Hardware: Flake L (58-key), XIAO BLE, split wireless
 * Layout: Standard Colemak-DH, single layer, no home-row mods, no combos
 *
 * Large layout matrix (large_transform):
 *   Row 0: cols 0-11  (12 keys — number row with outer modifier keys)
 *   Row 1: cols 0-11  (12 keys — top alpha row)
 *   Row 2: cols 0-11  (12 keys — home alpha row)
 *   Row 3: cols 0-11  (12 keys — bottom alpha row)
 *   Row 4: cols 1-10  (10 keys — thumb cluster)
 *
 * Colemak-DH alpha block (cols 1-10 of rows 1-3):
 *   Q W F P B   J L U Y ;
 *   A R S T G   M N E I O
 *   Z X C D V   K H , . /
 *
 * Outer columns (col 0 and col 11) carry modifier/utility keys.
 * Thumbs carry Cmd/Alt/Ctrl/Space on left, Shift/Cmd/Alt/Ctrl on right.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Colemak-DH";
            /*
             * 58 bindings in large_transform order:
             *
             * Row 0 (12):  ESC  1  2  3  4  5   |   6  7  8  9  0  MINUS
             * Row 1 (12):  ENTER Q  W  F  P  B   |   J  L  U  Y  ;  BSPC
             * Row 2 (12):  TAB  A  R  S  T  G   |   M  N  E  I  O  APOS
             * Row 3 (12):  LBKT Z  X  C  D  V   |   K  H  ,  .  /  RBKT
             * Thumb (10):     LGUI LALT LCTRL SPACE BSPC   DEL RSHFT RALT RCTRL RGUI
             */
            bindings = <
&kp ESC    &kp N1    &kp N2    &kp N3     &kp N4    &kp N5        &kp N6    &kp N7    &kp N8     &kp N9    &kp N0    &kp MINUS
&kp ENTER  &kp Q     &kp W     &kp F      &kp P     &kp B         &kp J     &kp L     &kp U      &kp Y     &kp SEMI  &kp BSPC
&kp TAB    &kp A     &kp R     &kp S      &kp T     &kp G         &kp M     &kp N     &kp E      &kp I     &kp O     &kp APOS
&kp LBKT   &kp Z     &kp X     &kp C      &kp D     &kp V         &kp K     &kp H     &kp COMMA  &kp DOT   &kp FSLH  &kp RBKT
           &kp LGUI  &kp LALT  &kp LCTRL  &kp SPACE &kp BSPC      &kp DEL   &kp RSHFT &kp RALT   &kp RCTRL &kp RGUI
            >;
        };
    };
};
